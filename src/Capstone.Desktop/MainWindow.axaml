<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Capstone.Core.ViewModels"
        xmlns:c="using:SharpQuest.Contracts"
        x:Class="Capstone.Desktop.MainWindow"
        x:DataType="vm:CatalogueViewModel"
        Title="Music library"
        Width="900" Height="560" MinWidth="640" MinHeight="400">

    <Panel>
        <!-- Shown until the library has loaded: the window never waits on the disk. -->
        <TextBlock x:Name="Status" Text="Loading your library…"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" />

        <Grid x:Name="Main" IsVisible="False" ColumnDefinitions="3*,2*" Margin="16">

            <!-- Left: search, list, count -->
            <DockPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBox DockPanel.Dock="Top" Watermark="Search titles and artists…"
                         Text="{Binding Filter}" Margin="0,0,0,8" />
                <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Opacity="0.7"
                           Text="{Binding Count, StringFormat='{}{0} showing'}" />
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="c:IItem">
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Right: details of the selection, Delete, and the new-track form -->
            <StackPanel Grid.Column="1" Spacing="10">
                <TextBlock Text="Details" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding Details}" TextWrapping="Wrap" MinHeight="40" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="▶ Play" Command="{Binding PlayCommand}" />
                    <Button Content="Delete selected" Command="{Binding RemoveCommand}" />
                </StackPanel>

                <!-- Greyed out unless a track is selected; the parameter is the rating. -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Rate:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Button Content="1★" Command="{Binding RateCommand}" CommandParameter="1" />
                    <Button Content="2★" Command="{Binding RateCommand}" CommandParameter="2" />
                    <Button Content="3★" Command="{Binding RateCommand}" CommandParameter="3" />
                    <Button Content="4★" Command="{Binding RateCommand}" CommandParameter="4" />
                    <Button Content="5★" Command="{Binding RateCommand}" CommandParameter="5" />
                    <Button Content="Clear" Command="{Binding RateCommand}" CommandParameter="" />
                </StackPanel>

                <Separator Margin="0,8" />

                <TextBlock Text="Add a track" FontWeight="SemiBold" FontSize="16" />
                <TextBox Watermark="Title" Text="{Binding NewTrack.Title}" />
                <TextBox Watermark="Artist" Text="{Binding NewTrack.Artist}" />
                <Grid ColumnDefinitions="*,8,*">
                    <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                              ItemsSource="{x:Static vm:TrackForm.Genres}"
                              SelectedItem="{Binding NewTrack.Genre}" />
                    <TextBox Grid.Column="2" Watermark="Length (3:45)" Text="{Binding NewTrack.Duration}" />
                </Grid>
                <Button Content="Add" Command="{Binding AddNewTrackCommand}" />
                <TextBlock Text="{Binding NewTrack.Error}" Foreground="IndianRed" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Panel>
</Window>
